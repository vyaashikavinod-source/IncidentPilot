# SANDBOX ONLY. Copy to .env and generate independent local values.
# Blank placeholders intentionally prevent Compose from starting unconfigured.
# Use random hexadecimal values (32+ characters); DB passwords must be URL-safe.
INCIDENTPILOT_POSTGRES_ADMIN_PASSWORD=
INCIDENTPILOT_DB_PASSWORD=
INCIDENTPILOT_SANDBOX_AUTH_TOKEN=
INCIDENTPILOT_INTERNAL_TOKEN=
INCIDENTPILOT_INCIDENT_TOKEN=
INCIDENTPILOT_OPERATOR_SIGNING_SECRET=
INCIDENTPILOT_AUDIT_SIGNING_SECRET=
INCIDENTPILOT_GRAFANA_ADMIN_USER=sandbox
INCIDENTPILOT_GRAFANA_ADMIN_PASSWORD=
# Optional when another local process already owns port 8000.
INCIDENTPILOT_GATEWAY_PORT=8000
INCIDENTPILOT_CONTROL_PLANE_PORT=8001
INCIDENTPILOT_AGENT_PORT=8002
INCIDENTPILOT_LLM_PROVIDER=fake
INCIDENTPILOT_LLM_MODEL=gpt-5-mini
# Optional for a separately hosted operator console. Example environment: production.
INCIDENTPILOT_OPERATOR_CONSOLE_ORIGIN=
# Set locally only when running a real evaluation; never commit a key.
INCIDENTPILOT_LLM_API_KEY=

# Supplied per service by Compose, or explicitly for local processes:
# INCIDENTPILOT_ENVIRONMENT=local
# INCIDENTPILOT_SERVICE_NAME=gateway
# INCIDENTPILOT_LOG_LEVEL=INFO
# INCIDENTPILOT_AUTH_URL=http://auth:8000
# INCIDENTPILOT_DATA_URL=http://data:8000
# INCIDENTPILOT_DATABASE_URL=postgresql+psycopg://incidentpilot:<url-safe-local-password>@postgres:5432/incidentpilot
# INCIDENTPILOT_BROKER_URL=redis://redis:6379/0
# INCIDENTPILOT_HTTP_TIMEOUT=3
# INCIDENTPILOT_WORKER_RETRY_LIMIT=3
# INCIDENTPILOT_WORKER_RETRY_DELAY=2
# INCIDENTPILOT_TELEMETRY_ENABLED=true
# INCIDENTPILOT_OTLP_ENDPOINT=http://otel-collector:4318
